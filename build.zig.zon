.{
    .name = .rosettacode,
    .version = "0.0.0",
    .fingerprint = 0xc6975e7a37bae59b, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",

    // Raylib is usually up to date wrt zig
    // Use the master branch and hope...
    // zig fetch --save "git+https://github.com/raysan5/raylib"

    // zig fetch --save "git+https://github.com/recombinant/primesieve"

    // zig fetch --save git+https://codeberg.org/ziglang/translate-c

    // zig fetch --save git+https://github.com/peymanmortazavi/csv-zero.git

    .dependencies = .{
        .csvzero = .{
            .url = "git+https://github.com/peymanmortazavi/csv-zero.git#a687d508e57b1cd62dc1efa7d90f268055e1ca46",
            .hash = "csvzero-0.2.0-YQXXvD3GAAB60CVoVAuz64YS3Lg3okE2UKRPviOe2lcL",
        },
        .primesieve = .{
            .url = "git+https://github.com/recombinant/primesieve#fc70205d648080fb1291a095baaa7272212976aa",
            .hash = "primesieve-0.0.0-H2AblWIOAAAc5ncPiR29ut4mAYJzZH6Znp5FeLM-yeMd",
        },
        .raylib = .{
            .url = "git+https://github.com/raysan5/raylib#30fa673ef2fa137588cf8b5732c65d76d86c1570",
            .hash = "raylib-6.0.0-whq8uDuRNwU-qsXm4RFf0ZBx11T8CE-vPfzcgAgQ24UH",
        },
        .translate_c = .{
