    },
    .paths = .{
        // The project was started using Zig 0.2 in 2018 with
        // no understanding of Zig. Hence the poor file layout
        // with the source files in the root folder.

        // This is insufficient. The source is not in `src`
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
